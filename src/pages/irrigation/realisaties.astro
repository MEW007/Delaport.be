---
import { Image } from 'astro:assets';
import Irrigation from '../../layouts/Irrigation.astro';
import aartselaar from '../../assets/realisaties/hoeve-aartselaar.jpeg';
import dakterras from '../../assets/realisaties/dakterras-antwerpen.jpeg';
import kempen from '../../assets/realisaties/hoeve-kempen.jpeg';
import beigem from '../../assets/realisaties/apotheek-beigem.jpeg';

// Nieuwe realisatie toevoegen: foto in src/assets/realisaties/ zetten, importeren en hier een regel bijzetten.
const projecten = [
  // `type` is optioneel (bv. 'Gazonberegening', 'Druppelleiding').
  { img: aartselaar, titel: 'Hoeve Aartselaar', type: '' },
  { img: dakterras, titel: 'Dakterras Antwerpen', type: '' },
  { img: kempen, titel: 'Hoeve Kempen', type: '' },
  { img: beigem, titel: 'Apotheek Beigem', type: '' },
];
---

<Irrigation
  title="Realisaties | Delaport Irrigation"
  description="Een greep uit onze projecten in automatische tuinberegening: hoeves, dakterrassen en bedrijfstuinen."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Realisaties</p>
      <h1>Ons werk</h1>
      <p class="lead">Elke installatie top afgewerkt: van grote gazons op hoeves tot dakterrassen in de stad.</p>
      <div class="gallery">
        {
          projecten.map((p) => (
            <figure>
              <Image src={p.img} alt={p.type ? `${p.titel} — ${p.type}` : p.titel} widths={[400, 700, 1000]} sizes="(max-width: 700px) 100vw, 50vw" />
              <figcaption>
                <strong>{p.titel}</strong>
                {p.type && <span>{p.type}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Irrigation>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin-top: 32px; }
  figure { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #fff; }
  figure img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption { padding: 14px 18px; display: flex; flex-direction: column; }
  figcaption span { color: var(--muted); font-size: 0.92rem; }
</style>
