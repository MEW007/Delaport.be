---
import '../styles/global.css';
import { site } from '../config';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  section?: 'group' | 'irrigation' | 'infrastructure';
  lang?: 'nl' | 'en';
  noindex?: boolean;
}

const { title, description, section = 'group', lang = 'nl', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hideFromSearch = noindex || (section === 'infrastructure' && !site.infrastructurePublic);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_BE' : 'en_GB'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;650;700&family=Manrope:wght@700;750;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body data-section={section}>
    <a class="skip" href="#main">{lang === 'nl' ? 'Naar inhoud' : 'Skip to content'}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <Analytics />
  </body>
</html>
